// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "sqlite"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

model Post {
    id        Int      @id @default(autoincrement())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    createdBy   User   @relation(fields: [createdById], references: [id])
    createdById String

    @@index([name])
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    role               String?
    primaryInsurance   String?
    secondaryInsurance String?
    organizationId     String?
    organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
    accounts           Account[]
    sessions      Session[]
    posts         Post[]
    provider      Provider?
    patient       Patient?
    messages      ClinicMessage[]
    clinicalEvents ClinicalEvent[]
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model Organization {
    id         String     @id @default(cuid())
    name       String     @unique
    users      User[]
    clinicians Provider[]
}

model Provider {
    id           String        @id
    firstName    String
    lastName     String
    credentials  String
    specialty    String
    email        String        @unique
    organizationId String?
    organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
    userId       String?       @unique
    user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
    patients     Patient[]     @relation("ProviderPanel")
    sharesSent   ShareRequest[] @relation("ShareFrom")
    sharesReceived ShareRequest[] @relation("ShareTo")
    medications  Medication[]
    appointments Appointment[] @relation("AppointmentProvider")
    nurseAppointments Appointment[] @relation("AppointmentNurse")
    scheduleBlocks ProviderScheduleBlock[]
    visits       Visit[]
    notes        ClinicalNote[]
    tasks        Task[]
    approvedSummaries PatientSummaryRecord[]
    messages     ClinicMessage[]
    orders       PrescriptionOrder[]
}

model Patient {
    id                 String             @id
    firstName          String
    lastName           String
    dateOfBirth        DateTime
    gender             String
    email              String             @unique
    phone              String
    psychiatricHistory String
    primaryProviderId   String
    primaryProvider     Provider           @relation("ProviderPanel", fields: [primaryProviderId], references: [id])
    preferredPharmacyId String?
    preferredPharmacy   Pharmacy?          @relation(fields: [preferredPharmacyId], references: [id], onDelete: SetNull)
    userId              String?            @unique
    user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
    createdAt          DateTime
    updatedAt          DateTime
    allergies          PatientAllergy[]
    conditions         PatientCondition[]
    emergencyContact   EmergencyContact?
    shareRequests      ShareRequest[]
    medications        Medication[]
    appointments       Appointment[]
    visits             Visit[]
    notes              ClinicalNote[]
    tasks              Task[]
    summary            PatientSummaryRecord?
    messages           ClinicMessage[]
    intakes            Intake[]
    orders             PrescriptionOrder[]
    events             ClinicalEvent[]
    reminders          Reminder[]

    @@index([primaryProviderId])
    @@index([preferredPharmacyId])
}

model PatientAllergy {
    id        String  @id @default(cuid())
    patientId String
    patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
    substance String

    @@index([patientId])
}

model PatientCondition {
    id          String  @id @default(cuid())
    patientId   String
    patient     Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
    description String

    @@index([patientId])
}

model EmergencyContact {
    id           String  @id @default(cuid())
    patientId    String  @unique
    patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
    name         String
    relationship String
    phone        String
}

model ShareRequest {
    id             String   @id @default(cuid())
    patientId      String
    patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
    fromProviderId String
    fromProvider   Provider @relation("ShareFrom", fields: [fromProviderId], references: [id])
    toProviderId   String
    toProvider     Provider @relation("ShareTo", fields: [toProviderId], references: [id])
    status         String
    createdAt      DateTime @default(now())

    @@index([patientId])
    @@index([fromProviderId])
    @@index([toProviderId])
}

model Medication {
    id                    String    @id @default(cuid())
    patientId             String
    patient               Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
    prescribingProviderId String
    prescribingProvider   Provider  @relation(fields: [prescribingProviderId], references: [id])
    medicationName        String
    genericName           String
    dosage                String
    route                 String
    frequency             String
    status                String
    startDate             DateTime
    endDate               DateTime?
    notes                 String?

    @@index([patientId])
}

model ProviderScheduleBlock {
    id          String   @id @default(cuid())
    providerId  String
    provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
    dayOfWeek   Int
    startMinute Int
    endMinute   Int
    slotMinutes Int
    kind        String

    @@index([providerId])
}

model Appointment {
    id              String    @id @default(cuid())
    patientId       String
    patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
    providerId      String
    provider        Provider  @relation("AppointmentProvider", fields: [providerId], references: [id])
    nurseId         String?
    nurse           Provider? @relation("AppointmentNurse", fields: [nurseId], references: [id], onDelete: SetNull)
    scheduledAt     DateTime
    durationMinutes Int
    appointmentType String
    status          String
    title           String
    description     String
    reasonForVisit     String
    cancellationReason String?
    joinToken          String?   @unique
    createdAt          DateTime
    visit              Visit?
    intake             Intake?
    orders             PrescriptionOrder[]
    events             ClinicalEvent[]
    reminders          Reminder[]

    @@index([patientId])
    @@index([providerId])
    @@index([nurseId])
    @@index([scheduledAt])
}

model ClinicMessage {
    id           String   @id @default(cuid())
    patientId    String
    patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
    providerId   String
    provider     Provider @relation(fields: [providerId], references: [id])
    authorUserId String
    author       User     @relation(fields: [authorUserId], references: [id])
    body         String
    createdAt    DateTime @default(now())

    @@index([patientId, createdAt])
}

model Visit {
    id                   String         @id @default(cuid())
    appointmentId        String         @unique
    appointment          Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
    patientId            String
    patient              Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
    providerId           String
    provider             Provider       @relation(fields: [providerId], references: [id])
    visitDate            DateTime
    chiefComplaint       String
    clinicalSummary      String
    followUpInstructions String
    status               String
    notes                ClinicalNote[]
    orders               PrescriptionOrder[]
    events               ClinicalEvent[]

    @@index([patientId])
}

model ClinicalNote {
    id         String   @id @default(cuid())
    visitId    String
    visit      Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
    patientId  String
    patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
    providerId String
    provider   Provider @relation(fields: [providerId], references: [id])
    noteType   String
    content    String
    status     String
    createdAt  DateTime
    updatedAt  DateTime

    @@index([visitId])
}

model PatientSummaryRecord {
    id                      String   @id @default(cuid())
    patientId               String   @unique
    patient                 Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
    approvedByProviderId    String
    approvedBy              Provider @relation(fields: [approvedByProviderId], references: [id])
    approvedAt              DateTime
    overview                String
    recentVisitSummary      String
    diagnoses               String
    currentMedications      String
    discontinuedMedications String
    outstandingTasks        String
    fingerprint             String
}

model Task {
    id                 String   @id @default(cuid())
    patientId          String
    patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
    assignedProviderId String
    assignedProvider   Provider @relation(fields: [assignedProviderId], references: [id])
    title              String
    description        String
    priority           String
    status             String
    dueDate            DateTime
    createdAt          DateTime

    @@index([patientId])
    @@index([assignedProviderId])
}

model Pharmacy {
    id        String              @id
    name      String
    street    String
    city      String
    state     String
    phone     String
    ncpdpId   String              @unique
    patients  Patient[]
    intakes   Intake[]
    orders    PrescriptionOrder[]
}

model Intake {
    id                     String      @id @default(cuid())
    appointmentId          String      @unique
    appointment            Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
    patientId              String
    patient                Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
    phq9Score              Int
    gad7Score              Int
    safetyConcern          Boolean
    safetyNote             String?
    medicationChangesNote  String?
    pharmacyId             String
    pharmacy               Pharmacy    @relation(fields: [pharmacyId], references: [id])
    completedAt            DateTime

    @@index([patientId])
    @@index([pharmacyId])
}

model PrescriptionOrder {
    id                    String      @id @default(cuid())
    visitId               String?
    visit                 Visit?      @relation(fields: [visitId], references: [id], onDelete: SetNull)
    appointmentId         String?
    appointment           Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
    patientId             String
    patient               Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
    prescribingProviderId String
    prescribingProvider   Provider    @relation(fields: [prescribingProviderId], references: [id])
    pharmacyId            String
    pharmacy              Pharmacy    @relation(fields: [pharmacyId], references: [id])
    medicationName        String
    genericName           String
    dosage                String
    route                 String
    frequency             String
    quantity              Int
    refills               Int
    sig                   String
    action                String
    status                String
    statusDetail          String
    allergyOverrideReason String?
    medicationId          String?
    createdAt             DateTime    @default(now())
    updatedAt             DateTime    @updatedAt
    events                ClinicalEvent[]

    @@index([patientId])
    @@index([visitId])
    @@index([appointmentId])
    @@index([pharmacyId])
}

model ClinicalEvent {
    id            String             @id @default(cuid())
    patientId     String
    patient       Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
    actorUserId   String
    actor         User               @relation(fields: [actorUserId], references: [id])
    type          String
    payload       String
    visitId       String?
    visit         Visit?             @relation(fields: [visitId], references: [id], onDelete: SetNull)
    appointmentId String?
    appointment   Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
    orderId       String?
    order         PrescriptionOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
    createdAt     DateTime           @default(now())

    @@index([patientId, createdAt])
    @@index([appointmentId])
    @@index([orderId])
}

model Reminder {
    id            String      @id @default(cuid())
    appointmentId String
    appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
    patientId     String
    patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
    dueAt         DateTime
    channel       String
    kind          String
    status        String
    body          String
    sentAt        DateTime?

    @@index([patientId])
    @@index([appointmentId])
    @@index([status, dueAt])
}
